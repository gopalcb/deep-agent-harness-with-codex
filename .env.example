# Demo launcher generates its own internal token and needs no model credential.
LAB_MODE=demo
LAB_PROJECT_ID=lab
# For manual startup, configure a strong matching internal token in both processes.
# LAB_INTERNAL_TOKEN=
# LAB_DATA_DIR=/absolute/path/outside/writable/repository
CODEX_BASE_URL=http://127.0.0.1:3100
LAB_ORCHESTRATOR_URL=http://127.0.0.1:8000
# Live adapters are opt-in; never commit tokens.
# LAB_BROWSER_TOKEN=
# LAB_EXECUTION_CONFIG=/absolute/path/execution-config.json
# LAB_PLANNER_MODEL=provider:model
LAB_CONTEXT_CAPACITY=32000
# LAB_DOCUMENT_URL=https://trusted-document-service.example
# LAB_DOCUMENT_TOKEN=
# LAB_MCP_URL=https://trusted-mcp.example/mcp
# LAB_MCP_TOKEN=
# LAB_MCP_TOOLS={"research":["search_documents"]}
# LAB_INTEGRATION_PERMISSIONS=search_documents
LANGSMITH_TRACING=false
