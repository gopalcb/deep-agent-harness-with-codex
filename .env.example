LAB_MODE=demo
LAB_PROJECT_ID=lab
# LAB_INTERNAL_TOKEN=
# LAB_DATA_DIR=/absolute/path/outside/the/live-workspace
LAB_ROUTER_URL=http://127.0.0.1:8000
# LAB_ROUTER_MODEL=provider:model
# LAB_WORKSPACE=/absolute/path/to/git-workspace
# LAB_BROWSER_TOKEN=
# LAB_UI_DIR=/absolute/path/to/built/ui
LANGSMITH_TRACING=false
# Enable only for an existing agent with authorized workspace tools.
LAB_BEDROCK_ENABLED=false
LAB_FALLBACK_PROVIDER=bedrock
# Alternative: local Ollama model, e.g. your installed small Qwen model.
# LAB_FALLBACK_PROVIDER=local
# LAB_LOCAL_MODEL=qwen2.5-coder:3b
# Explicit files shared with the selected model and writable by the fallback.
# LAB_EDIT_FILES=["example.py"]
LAB_BEDROCK_REGION=us-east-1
LAB_BEDROCK_AGENT_ID=YOUR_AGENT_ID
LAB_BEDROCK_ALIAS_ID=YOUR_ALIAS_ID
# boto3 uses your existing AWS profile or workload role; do not add access keys here.
# AWS_PROFILE=your-existing-profile
# LAB_CHECKPOINT_DIR=/absolute/path/outside/workspace
# LAB_VALIDATION_COMMANDS=[["python","-m","pytest"]]
